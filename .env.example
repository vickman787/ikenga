# Ikenga — copy to .env and fill in. Never commit a real .env.
# Step 2: no secrets are needed to run the tests or the demo (everything
# mocked/gated). Live Sepolia/mainnet steps need the keys below, created by
# the user — never put a real key in chat or in the repo.

# --- Celo (public, no secret) ---
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Postgres for the ledger (see docker-compose.yml). Unset = in-memory ledger.
DATABASE_URL=postgres://ikenga:ikenga@localhost:5433/ikenga
# Optional: agent runner
IKENGA_DATA_DIR=./data

# --- Hackathon attribution (assigned at Loops registration — REQUIRED for
# counted transactions; a self-derived code is silently never credited) ---
IKENGA_ATTRIBUTION_TAG=
# Set to 1 to run live-gated tests (they spend real testnet funds — never in CI)
IKENGA_LIVE_TESTS=

# --- x402 (Celo facilitator) ---
# API key created by a human on https://x402.celo.org (GitHub sign-in for
# mainnet credits). Required only for /settle; /verify and /supported are open.
X402_API_KEY=
X402_FACILITATOR_URL=https://api.x402.celo.org
# Live-gated Sepolia settlement test only:
IKENGA_TEST_PRIVATE_KEY=
IKENGA_LIVE_PAY_TO=

# --- Textile FX (keyless is the default — no key needed) ---
# Partner API key only if webhooks/rate limits are wanted; keyless uses a
# wallet TakerControl proof instead. Never send both.
TEXTILE_API_KEY=
TEXTILE_API_BASE_URL=https://api.textilecredit.com/v2
# Taker wallet that holds USDT and executes swaps (the quote is bound to it)
IKENGA_FX_TAKER_ADDRESS=
# Live-gated BSC testnet swap test only:
IKENGA_TESTNET_TAKER_PRIVATE_KEY=

# --- Self Agent ID gate ---
# Agent signing key, exported within 30 min of registration. Never commit.
AGENT_PRIVATE_KEY=
# mainnet (default) or sepolia. A Sepolia agent is unknown to mainnet.
SELF_NETWORK=mainnet
# Max agents per human. Unset = 1 (SDK default, fail-closed). 0 = no limit.
SELF_SYBIL_LIMIT=
SELF_AGENT_ID=
SELF_AGENT_ADDRESS=
# Optional overrides
SELF_RPC_URL=
SELF_RATE_LIMIT_PER_MINUTE=60
SELF_RATE_LIMIT_PER_HOUR=600

# --- Contracts / deploy ---
# Deployer key for forge script (env only, never in chat or in the repo)
# PRIVATE_KEY=
# Celoscan API key for --verify (create at celoscan.io)
CELOSCAN_API_KEY=
# USDT token address for the deploy (Sepolia test token on Sepolia, mainnet USDT on mainnet)
USDT_TOKEN=
IKENGA_BOSS=
IKENGA_CUSTOMER=
IKENGA_BOND=
IKENGA_SPEC_HASH=
IKENGA_AGENT_URI=
# Set to true only for an explicitly approved mainnet registration run
IKENGA_ALLOW_MAINNET=
